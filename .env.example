# Copy to .env (or use as-is for local defaults). All values are dev defaults.
DEBUG=1
SECRET_KEY=dev-insecure-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,frontend

POSTGRES_DB=documents
POSTGRES_USER=documents
POSTGRES_PASSWORD=documents
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MAX_UPLOAD_BYTES=26214400
# OCR engine: "tesseract" (real, needs the binary) or "mock" (canned text)
OCR_ENGINE=tesseract
OCR_LANGUAGES=eng
OCR_MOCK_LATENCY=0.2
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_AFTER_SECONDS=300
WORKER_POLL_INTERVAL=1.0